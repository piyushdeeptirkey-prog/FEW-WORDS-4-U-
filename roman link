<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>For You</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: radial-gradient(circle at top, #ffe6eb, #f9c2d1);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      overflow: hidden;
      position: relative;
    }
    .card {
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(10px);
      padding: 2.5rem 2rem;
      border-radius: 20px;
      box-shadow: 0 10px 30px rgba(220, 53, 69, 0.15);
      text-align: center;
      max-width: 420px;
      width: 90%;
      z-index: 2;
      animation: fadeIn 1.2s ease-out;
    }
    h1 { color: #d63384; font-size: 1.8rem; margin-bottom: 1rem; }
    p { color: #555; line-height: 1.6; font-size: 1.05rem; margin-bottom: 1.5rem; }
    .btn {
      background: #e63946;
      color: #fff;
      border: none;
      padding: 0.8rem 1.6rem;
      border-radius: 50px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 4px 14px rgba(230, 57, 70, 0.4);
      transition: transform 0.2s ease, background 0.2s ease;
    }
    .btn:hover { transform: scale(1.05); background: #d62828; }
    .hidden-message {
      display: none;
      margin-top: 1.5rem;
      padding-top: 1.5rem;
      border-top: 1px dashed #f1aeb5;
      animation: slideUp 0.6s ease-out forwards;
    }
    .heart-bg {
      position: absolute;
      color: rgba(230, 57, 70, 0.4);
      animation: floatUp linear infinite;
      user-select: none;
      pointer-events: none;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: scale(0.95); }
      to { opacity: 1; transform: scale(1); }
    }
    @keyframes slideUp {
      from { opacity: 0; transform: translateY(15px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes floatUp {
      0% { transform: translateY(105vh) rotate(0deg); opacity: 0; }
      10% { opacity: 0.8; }
      90% { opacity: 0.8; }
      100% { transform: translateY(-10vh) rotate(360deg); opacity: 0; }
    }
  </style>
</head>
<body>

  <div class="card">
    <h1>Hey, you ❤️</h1>
    <p>I put this together because words sometimes fall short in person.</p>
    <button class="btn" onclick="revealNote()">Tap to open</button>
    
    <div class="hidden-message" id="secretNote">
      <p><strong>Every day with you is my favorite.</strong> Thank you for bringing so much light, laughter, and calm into my life.</p>
      <p style="font-size: 0.9rem; color: #888; margin-bottom: 0;">Yours always.</p>
    </div>
  </div>

  <script>
    function revealNote() {
      document.getElementById('secretNote').style.display = 'block';
      event.target.style.display = 'none';
    }

    function createHearts() {
      const symbols = ['❤️', '✨', '💖', '🌸'];
      for (let i = 0; i < 20; i++) {
        const heart = document.createElement('div');
        heart.className = 'heart-bg';
        heart.innerText = symbols[Math.floor(Math.random() * symbols.length)];
        heart.style.left = Math.random() * 100 + 'vw';
        heart.style.fontSize = (Math.random() * 1.5 + 1) + 'rem';
        heart.style.animationDuration = (Math.random() * 4 + 4) + 's';
        heart.style.animationDelay = (Math.random() * 5) + 's';
        document.body.appendChild(heart);
      }
    }
    createHearts();
  </script>
</body>
</html>
