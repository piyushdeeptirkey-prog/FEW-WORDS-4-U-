<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>For Someone Special</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, #fff0f3, #ffd1dc);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            overflow: hidden;
            position: relative;
        }

        /* The main container holding the message */
        .container {
            text-align: center;
            z-index: 10;
        }

        /* The CSS Heart Shape */
        .heart {
            background-color: #e63946;
            display: inline-block;
            height: 100px;
            margin: 0 10px;
            position: relative;
            top: 0;
            transform: rotate(-45deg);
            width: 100px;
            cursor: pointer;
            box-shadow: 0 5px 15px rgba(220, 53, 69, 0.2);
            /* This makes the heart 'beat' */
            animation: beat 1.2s infinite ease-in-out;
            transition: transform 0.3s ease, opacity 0.5s ease;
        }
        .heart:before, .heart:after {
            content: "";
            background-color: #e63946;
            border-radius: 50%;
            height: 100px;
            position: absolute;
            width: 100px;
        }
        .heart:before { top: -50px; left: 0; }
        .heart:after { left: 50px; top: 0; }

        /* What happens when she taps the heart */
        .heart.hide {
            opacity: 0;
            transform: scale(0.1) rotate(-45deg);
            pointer-events: none;
        }

        /* Initial message prompt */
        .prompt-text {
            color: #d63384;
            margin-top: 30px;
            font-size: 1.1rem;
            animation: fadeIn 1s ease-out;
        }

        /* The hidden beautiful message */
        .special-note {
            opacity: 0;
            transform: translateY(20px);
            transition: all 1s ease-out;
            max-width: 400px;
            margin: 0 auto;
            display: none;
        }
        .special-note.reveal {
            opacity: 1;
            transform: translateY(0);
            display: block;
        }
        .special-note h1 {
            color: #c9184a;
            font-size: 2.2rem;
            margin-bottom: 15px;
        }
        .special-note p {
            color: #555;
            font-size: 1.2rem;
            line-height: 1.6;
        }

        /* Floating background heart styles */
        .floating-heart {
            position: absolute;
            bottom: -50px;
            color: rgba(230, 57, 70, 0.6);
            user-select: none;
            pointer-events: none;
            animation: floatUp linear infinite;
        }

        /* Animations */
        @keyframes beat {
            0% { transform: scale(1) rotate(-45deg); }
            15% { transform: scale(1.1) rotate(-45deg); }
            30% { transform: scale(1) rotate(-45deg); }
            45% { transform: scale(1.1) rotate(-45deg); }
            100% { transform: scale(1) rotate(-45deg); }
        }
        @keyframes floatUp {
            0% { transform: translateY(0) rotate(0deg); opacity: 0; }
            10% { opacity: 0.9; }
            90% { opacity: 0.9; }
            100% { transform: translateY(-110vh) rotate(360deg); opacity: 0; }
        }
        @keyframes fadeIn {
            from { opacity: 0; } to { opacity: 1; }
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- The interactive heart -->
        <div class="heart" id="mainHeart" onclick="revealMessage()"></div>
        <p class="prompt-text" id="promptText">A message for you</p>

        <!-- The beautiful message (revealed on tap) -->
        <div class="special-note" id="specialNote">
            <h1>Hey, lovely</h1>
            <p>I just wanted to remind you of something important...</p>
            <p><strong>You’re beautiful, for real.</strong></p>
        </div>
    </div>

    <script>
        function revealMessage() {
            // Hide the initial heart and text
            document.getElementById('mainHeart').classList.add('hide');
            document.getElementById('promptText').style.display = 'none';

            // Reveal the main message
            document.getElementById('specialNote').classList.add('reveal');

            // Start the floating heart animation shower
            startHeartShower();
        }

        function startHeartShower() {
            const symbols = ['❤️', '💖', '✨', '🌸'];
            
            // Create a burst of hearts
            for (let i = 0; i < 35; i++) {
                setTimeout(() => {
                    createFloatingHeart(symbols);
                }, i * 100);
            }

            // Keep a continuous gentle flow
            setInterval(() => {
                createFloatingHeart(symbols);
            }, 800);
        }

        function createFloatingHeart(symbols) {
            const heart = document.createElement('div');
            heart.className = 'floating-heart';
            heart.innerText = symbols[Math.floor(Math.random() * symbols.length)];
            heart.style.left = Math.random() * 100 + 'vw';
            
            // Randomize size and speed for a natural look
            const size = (Math.random() * 1.5 + 0.8) + 'rem';
            heart.style.fontSize = size;
            
            const duration = (Math.random() * 4 + 3) + 's';
            heart.style.animationDuration = duration;
            
            document.body.appendChild(heart);

            // Clean up the element after the animation finishes
            setTimeout(() => {
                heart.remove();
            }, (parseInt(duration) + 1) * 1000);
        }
    </script>
</body>
</html>
